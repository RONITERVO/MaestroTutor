#
# Client configuration. Everything here is embedded in the built bundle and is
# therefore public — never put a secret in this file. The Gemini API key for
# managed mode lives only in the backend (see functions/.env.example).

# --- Managed access ---------------------------------------------------------
# Managed access is offered only when the Firebase and backend settings below
# are complete. There is no independent feature flag that can leave a
# configured production backend invisible to the human client.
#
# Base URL of the deployed `api` function, e.g.
# https://europe-west1-<project>.cloudfunctions.net/api
VITE_BACKEND_BASE_URL=

# --- Firebase (client) ------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# App Check. Use the reCAPTCHA Enterprise site key for web. The debug token is
# for local development only and must never be set in a production build.
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# --- Google sign-in ---------------------------------------------------------
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_SERVER_CLIENT_ID=

# --- Managed Stripe checkout ------------------------------------------------
# Pack ids must exactly match MANAGED_CREDIT_PACKS in Functions.
VITE_MANAGED_CREDIT_PACK_IDS=
# Keep false for Play-distributed production builds until external checkout is
# enrolled and approved. Staging/internal builds may opt in for Android tests.
VITE_ANDROID_EXTERNAL_STRIPE_CHECKOUT_ENABLED=false
