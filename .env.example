#
# Client configuration. Everything here is embedded in the built bundle and is
# therefore public — never put a secret in this file. The Gemini API key for
# managed mode lives only in the backend (see functions/.env.example).

# --- Managed mode -----------------------------------------------------------
# Off by default. Managed mode spends real money on the user's behalf and
# cannot be exercised end to end without a live Firebase project and a real
# Play purchase, so it ships dark and is switched on deliberately once the
# backend has been verified against staging.
VITE_MANAGED_MODE_ENABLED=false

# --- Backend ----------------------------------------------------------------
# Base URL of the deployed `api` function, e.g.
# https://europe-west1-<project>.cloudfunctions.net/api
VITE_BACKEND_BASE_URL=

# --- Firebase (client) ------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# App Check. Use the reCAPTCHA Enterprise site key for web. The debug token is
# for local development only and must never be set in a production build.
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# --- Google sign-in ---------------------------------------------------------
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_SERVER_CLIENT_ID=

# --- Google Play ------------------------------------------------------------
VITE_GOOGLE_PLAY_PACKAGE_NAME=com.ronitervo.maestrotutor
# Comma separated consumable credit-pack product ids, as configured in Play.
VITE_MANAGED_BILLING_PRODUCT_IDS=
