rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // A real root document carries lifecycle/schema metadata. It contains no
      // profile or billing data and is only readable by its owner.
      allow read: if ownsUser(userId);
      allow write: if false;

      match /managedAccounts/{accountId} {
        allow read: if ownsUser(userId);
        allow write: if false;

        match /billingEvents/{entryId} {
          allow read: if ownsUser(userId);
          allow write: if false;
        }

        match /usageEvents/{entryId} {
          allow read: if ownsUser(userId);
          allow write: if false;
        }

        match /entitlements/{entitlementId} {
          allow read: if ownsUser(userId);
          allow write: if false;
        }

        // Reservations are internal transaction state, not account history.
        match /reservations/{reservationId} {
          allow read, write: if false;
        }
      }

      match /runtime/{docId} {
        allow read, write: if false;
      }

      match /files/{fileId} {
        allow read, write: if false;
      }

      match /liveLeases/{leaseId} {
        allow read, write: if false;
      }
    }

    // Provider-scoped, hashed idempotency claims. Server-only: a client that
    // could write one could mint credits.
    match /purchaseClaims/{purchaseKey} {
      allow read, write: if false;
    }

    // Immutable Stripe grant snapshots, created and consumed only by the
    // backend. A client must never be able to change what a paid session buys.
    match /checkoutGrants/{sessionId} {
      allow read, write: if false;
    }

    match /rateLimitWindows/{windowId} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow read, write: if false;
    }

    match /cleanupJobs/{jobId} {
      allow read, write: if false;
    }

    match /accountDeletionClaims/{claimId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
