{
  "name": "maestrotutor-functions",
  "private": true,
  "main": "lib/functions/src/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "serve": "firebase emulators:start --only functions,firestore",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test test/*.unit.cjs",
    "test:cors": "npm run build && node test/cors.unit.cjs",
    "test:emulator": "npm run build && firebase emulators:exec --config ../firebase.json --only firestore --project demo-maestrotutor \"node test/managedBilling.emulator.cjs\"",
    "smoke:gemini": "node test/gemini.provider-smoke.mjs",
    "deploy": "firebase deploy --only functions,firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@google/genai": "^1.45.0",
    "express": "^4.21.2",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "googleapis": "^154.0.0",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "firebase-tools": "^15.28.2",
    "typescript": "^5.6.3"
  }
}
