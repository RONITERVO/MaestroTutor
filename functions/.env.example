# Firebase Functions region
MAESTRO_FUNCTION_REGION=europe-west1

# Production secrets are stored in Google Secret Manager and bound in
# functions/src/index.ts. For local emulators, put the same names in
# functions/.secret.local (which is gitignored): GEMINI_API_KEY,
# STRIPE_SECRET and STRIPE_WEBHOOK_SECRET.

# Android package id used for Google Play purchase verification
GOOGLE_PLAY_PACKAGE_NAME=com.ronitervo.maestrotutor

# Browser/webview origins allowed to call the backend
ALLOWED_ORIGINS=https://chatwithmaestro.com,https://chatwithmaestro.web.app,https://localhost,http://localhost,http://localhost:5173,capacitor://localhost

# --- Credit packs -----------------------------------------------------------
# One catalogue for both storefronts, as `id:credits:cents[:playProductId]`.
# The Play product id is optional — a pack without one is sold on the web only.
# Keeping a single list is deliberate: two lists would let Play and Stripe
# disagree about what a pack contains, which is the user paying one store's
# price for another store's quantity.
MANAGED_CREDIT_PACKS=pack_1000:1000:299:maestro_credits_1000

# --- Stripe (web payments) --------------------------------------------------
# Web only. Google Play's payments policy requires Play Billing for purchases
# made inside the Android app, so Stripe never serves the app itself.
# Stripe's restricted key and webhook signing secret are bound from Secret
# Manager. Without the signing secret every webhook is rejected, which is the
# intended failure: an unverified webhook is just an anonymous POST.
# Where Checkout returns the buyer, e.g. https://chatwithmaestro.com
APP_URL=https://chatwithmaestro.com
BILLING_CURRENCY=eur

# Credit conversion: 1000 means 1 USD of Gemini cost becomes 1000 billed credits
MANAGED_CREDITS_PER_USD=1000

# Keep false until both web and native App Check are configured and verified.
# Once true, every authenticated backend request must send a valid App Check token.
REQUIRE_APPCHECK=false

# Single-use live/audio tokens by default
GEMINI_LIVE_TOKEN_USES=1

# Managed live token guardrails
MANAGED_LIVE_TOKEN_LIFETIME_SECONDS=180
MANAGED_MAX_ACTIVE_LIVE_SOCKETS=2

# Managed upload controls
MANAGED_MAX_ACTIVE_FILES_PER_USER=20
MANAGED_UPLOAD_CREDITS_PER_MB=10
# Cloud Functions v2 accepts at most 32 MiB per request. The effective value is
# also capped server-side so base64 plus its JSON envelope stays below that.
MANAGED_MAX_UPLOAD_BYTES=24379389

# Reservation expiry and music token charge
RESERVATION_TTL_MINUTES=30
MANAGED_MUSIC_SESSION_CREDITS=120

# --- Abuse limits -----------------------------------------------------------
# Credits bound what a user can spend, not how fast they can ask. These bound
# the request rate itself, which is what a client stuck in a retry loop
# consumes even when every request fails before it reserves anything.
MANAGED_RATE_LIMIT_PER_MINUTE=60
# Anonymous safety reports use a separate, tighter per-client limit.
MANAGED_ANONYMOUS_REPORT_RATE_LIMIT_PER_MINUTE=5
# Deliberately much tighter: every live token mints real Gemini access and
# reserves credits to do it.
MANAGED_LIVE_TOKEN_RATE_LIMIT_PER_MINUTE=6

# Bound Cloud Run scaling and per-instance parallelism for the API function.
MANAGED_FUNCTION_MAX_INSTANCES=10
MANAGED_FUNCTION_CONCURRENCY=20
