# Firebase Functions region
MAESTRO_FUNCTION_REGION=europe-west1

# Production secrets are stored in Google Secret Manager and bound in
# functions/src/index.ts. For local emulators, put the same names in
# functions/.secret.local (which is gitignored): GEMINI_API_KEY,
# STRIPE_SECRET and STRIPE_WEBHOOK_SECRET.

# Browser/webview origins allowed to call the backend
ALLOWED_ORIGINS=https://chatwithmaestro.com,https://chatwithmaestro.web.app,https://localhost,http://localhost,http://localhost:5173,capacitor://localhost

# --- Credit packs -----------------------------------------------------------
# The sole Stripe catalogue, as `id:credits:cents`. The id is shared unchanged
# by the hosted UI, Android external browser adapter, Core SDK and JSON-RPC.
MANAGED_CREDIT_PACKS=pack_1000:1000:299

# --- Stripe managed-credit payments ----------------------------------------
# Stripe's restricted key and webhook signing secret are bound from Secret
# Manager. Without the signing secret every webhook is rejected, which is the
# intended failure: an unverified webhook is just an anonymous POST.
# Where Checkout returns the buyer, e.g. https://chatwithmaestro.com. Native
# Android opens the same URL in a Custom Tab only when its release build is
# explicitly enabled after external-checkout programme enrollment.
APP_URL=https://chatwithmaestro.com
BILLING_CURRENCY=eur

# Credit conversion: 1000 means 1 USD of Gemini cost becomes 1000 billed credits
MANAGED_CREDITS_PER_USD=1000

# Production is fail-closed: every authenticated backend request must send a
# valid App Check token. `false` is an incident-only rollback after both web and
# Android configuration have been checked; document and reverse that rollback.
REQUIRE_APPCHECK=true

# Single-use live/audio tokens by default
GEMINI_LIVE_TOKEN_USES=1

# Managed live token guardrails
MANAGED_LIVE_TOKEN_LIFETIME_SECONDS=120
MANAGED_LIVE_GATEWAY_URL=
# Disabled until room Live client, provider usage trace and rollout QA pass.
MANAGED_LIVE_ROOM_TOOLS_ENABLED=false
MANAGED_LIVE_GATEWAY_TICKET_SECONDS=45
MANAGED_MAX_ACTIVE_LIVE_SOCKETS=2

# Managed upload controls
MANAGED_MAX_ACTIVE_FILES_PER_USER=20
MANAGED_UPLOAD_CREDITS_PER_MB=10
# Cloud Functions v2 accepts at most 32 MiB per request. The effective value is
# also capped server-side so base64 plus its JSON envelope stays below that.
MANAGED_MAX_UPLOAD_BYTES=24379389

# Server-owned model allowlists. Managed text models use stable IDs: provider
# `*-latest` aliases can hot-swap behavior and prices without a deploy. The
# backend maps the two historical text aliases to these pins for installed
# client compatibility. Keep this synchronized with the public registry and
# pricing tests before a model change.
MANAGED_ALLOWED_GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash-image
MANAGED_ALLOWED_LIVE_MODELS=gemini-2.5-flash-native-audio-preview-12-2025,gemini-3.1-flash-live-preview
MANAGED_ALLOWED_MUSIC_MODELS=lyria-realtime-exp
# A grounded Gemini 3 request can perform more than one separately billed
# search query. Reserve this many at list price, then settle actual queries.
MANAGED_SEARCH_RESERVATION_QUERIES=10
# Hard response ceiling. The backend reserves this output budget whenever the
# client does not ask for a smaller one, so a prepaid request is cost-bounded.
MANAGED_MAX_OUTPUT_TOKENS=8192

# Reservation expiry and music token charge
RESERVATION_TTL_MINUTES=30
# Smallest positive managed-service fee; not a claimed Lyria provider tariff.
MANAGED_MUSIC_SESSION_CREDITS=1

# --- Abuse limits -----------------------------------------------------------
# Credits bound what a user can spend, not how fast they can ask. These bound
# the request rate itself, which is what a client stuck in a retry loop
# consumes even when every request fails before it reserves anything.
MANAGED_RATE_LIMIT_PER_MINUTE=60
# Anonymous safety reports use a separate, tighter per-client limit.
MANAGED_ANONYMOUS_REPORT_RATE_LIMIT_PER_MINUTE=5
# Deliberately much tighter: every live token mints real Gemini access and
# reserves credits to do it.
MANAGED_LIVE_TOKEN_RATE_LIMIT_PER_MINUTE=6

# Bound Cloud Run scaling and per-instance parallelism for the API function.
MANAGED_FUNCTION_MAX_INSTANCES=10
MANAGED_FUNCTION_CONCURRENCY=20
MANAGED_DAILY_SPEND_LIMIT_USD=100

# --- Quest managed-access bootstrap (not enabled/deployed yet) --------------
# This is only the Meta attestation -> Firebase App Check backend. Native
# attestation, shared web CustomProvider and account linking are still pending.
# The separate questAttestation function alone binds META_QUEST_APP_SECRET.
# Put that secret in Secret Manager / .secret.local, never a VITE_ variable.
QUEST_ATTESTATION_ENABLED=false
QUEST_META_APP_ID=
QUEST_FIREBASE_APP_ID=
QUEST_ANDROID_PACKAGE=
# SHA-256 of the actual Store signing certificate, lowercase hex; comma-separated
# accepted certificates allow deliberate rotation. Never use the debug key.
QUEST_SIGNING_SHA256=
QUEST_MINIMUM_VERSION_CODE=
# Required before enablement: actual verified ingress IPs/CIDRs. No wildcard,
# blanket trust-proxy=true, or guessed hop count. Check every published route.
QUEST_ATTESTATION_TRUSTED_PROXY_CIDRS=
# After client integration, add https://appassets.androidplatform.net to the
# managed API's ALLOWED_ORIGINS. CORS does not replace Auth or App Check.
